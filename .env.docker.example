# docker compose 用的环境变量：复制为 .env.docker 后填写
AUTH_SECRET=change-me-to-a-long-random-string
APP_MASTER_KEY=change-me-to-64-hex-chars
ADMIN_EMAIL=admin@mailbox.local
ADMIN_PASSWORD=change-me
# 对外访问地址（OAuth 回调用）
APP_BASE_URL=https://mail.example.com
# PostgreSQL 密码（与 docker-compose.yml 一致）
POSTGRES_PASSWORD=mailbox
